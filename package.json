{
	"name": "@hackclub/ari",
	"version": "0.1.1",
	"description": "Official JavaScript and TypeScript SDK for Ari program integrations",
	"homepage": "https://github.com/hackclub/ari.js#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hackclub/ari.js.git"
	},
	"bugs": {
		"url": "https://github.com/hackclub/ari.js/issues"
	},
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist",
		"dist-cjs",
		"docs",
		"examples",
		"AGENTS.md",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist-cjs/index.js"
		}
	},
	"main": "./dist-cjs/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"smoke": "bun scripts/smoke.ts",
		"typecheck": "tsc -p tsconfig.json",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "bun run format:check && bun run typecheck && bun test && bun run build && bun run smoke",
		"pack:check": "bun pm pack --dry-run",
		"prepublishOnly": "bun run check && bun run pack:check"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"prettier": "^3.8.1",
		"typescript": "^6.0.2"
	}
}
